# Copy this file to .env and fill it in.
PORT=7000
DBURL=mongodb://127.0.0.1:27017/mellowweather
SESSION_SECRET=change-this-to-a-long-random-text      # also used to encrypt two-factor secrets

# Where the website runs (used for CORS and for links inside emails)
CLIENT_URL=http://localhost:5173

# Email (password reset, verification, daily forecast). Leave SMTP_HOST empty in development:
# emails are then printed in this terminal instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MellowWeather <no-reply@yourdomain.com>

# "Sign in with Google" (optional). Create an OAuth Client ID (type: Web) in Google Cloud Console,
# add http://localhost:5173 as an authorised JavaScript origin, and paste the Client ID here.
GOOGLE_CLIENT_ID=

# Identifies your app politely to MET Norway / Open-Meteo (they ask for a contact)
CONTACT_EMAIL=you@example.com

# Set to 1 to stop the 15-minute notification scheduler (useful while testing)
DISABLE_SCHEDULER=0

# ---- Added in v3 ----
# Rate limits (requests per window, per IP). Defaults: 240 per minute for the API, 60 per 15 min for sign-in routes
#API_RATE_LIMIT=240
#AUTH_RATE_LIMIT=60
# Production: set NODE_ENV=production (HTTPS-only cookies, requires SESSION_SECRET of 24+ characters)
#NODE_ENV=production
# Behind nginx / Render / Railway etc. set 1 so real visitor IPs are used (rate limits, session info)
#TRUST_PROXY=1
# Only if the website and API are on different domains: none (requires NODE_ENV=production / HTTPS)
#COOKIE_SAMESITE=lax
# Run notifications in a separate process: RUN_SCHEDULER_IN_APP=0 here, then `npm run worker`
#RUN_SCHEDULER_IN_APP=1
# Browser push notifications: `npx web-push generate-vapid-keys`
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
# Optional upgrades (free tiers): minute-by-minute rain + pollen index, and a better place search
#TOMORROW_API_KEY=
#GEOAPIFY_KEY=
